# ============================================================
# Carva — Environment Variables Template
# ============================================================
# Copy this file to .env and replace placeholder values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=carva_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Production database (Kamal deployment)
CARVA_DATABASE_NAME=carva_production
CARVA_DATABASE_USERNAME=postgres
CARVA_DATABASE_PASSWORD=

# ----------------------------------------------------------
# REDIS (Cache / Queue / Cable)
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------------------
# RAILS
# ----------------------------------------------------------
RAILS_ENV=development
RAILS_LOG_LEVEL=debug
RAILS_MAX_THREADS=5
RAILS_HOST=carva.com

# Secret keys — generate with: rails secret
# ----------------------------------------------------------
SECRET_KEY_BASE=your_secret_key_base_here
SESSION_SECRET=your_session_secret_here
RAILS_MASTER_KEY=your_rails_master_key_here

# ----------------------------------------------------------
# AUTH / JWT (devise-jwt)
# ----------------------------------------------------------
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400
JWT_ISSUER=carva-api

# ----------------------------------------------------------
# STRIPE (Payments)
# ----------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ----------------------------------------------------------
# SENTRY (Error Tracking)
# ----------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ----------------------------------------------------------
# ACTION MAILER (Email / SMTP)
# ----------------------------------------------------------
MAILER_DEFAULT_FROM=noreply@carva.com
MAILER_DEFAULT_REPLY_TO=noreply@carva.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=

# ----------------------------------------------------------
# PUMA / DEPLOYMENT
# ----------------------------------------------------------
PORT=3000
SOLID_QUEUE_IN_PUMA=true
PIDFILE=tmp/pids/server.pid
WEB_CONCURRENCY=2
JOB_CONCURRENCY=1
CI=false

# ----------------------------------------------------------
# DEVELOPMENT / TESTING
# ----------------------------------------------------------
PROFILE=false
